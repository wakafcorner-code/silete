  invoices            invoices?             @relation(fields: [invoice_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_ar_invoice")

  @@index([company_id], map: "fk_ar_company")
  @@index([customer_id], map: "fk_ar_customer")
  @@index([invoice_id], map: "fk_ar_invoice")
}

model roles {
  id          BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  name        String       @unique(map: "name") @db.VarChar(80)
  description String?      @db.VarChar(255)
  user_roles  user_roles[]
}

model sales_items {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  sales_order_id BigInt       @db.UnsignedBigInt
  product_id     BigInt       @db.UnsignedBigInt
  quantity       Decimal      @db.Decimal(18, 4)
  unit_price     Decimal      @db.Decimal(18, 2)
  tax_amount     Decimal      @default(0.00) @db.Decimal(18, 2)
  total_amount   Decimal      @default(0.00) @db.Decimal(18, 2)
  sales_orders   sales_orders @relation(fields: [sales_order_id], references: [id], onUpdate: Restrict, map: "fk_sales_item_order")
  products       products     @relation(fields: [product_id], references: [id], onUpdate: Restrict, map: "fk_sales_item_product")

  @@index([sales_order_id], map: "fk_sales_item_order")
  @@index([product_id], map: "fk_sales_item_product")
}

model sales_orders {
  id           BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  company_id   BigInt              @db.UnsignedBigInt
  customer_id  BigInt              @db.UnsignedBigInt
  branch_id    BigInt?             @db.UnsignedBigInt
  order_no     String              @db.VarChar(50)
  order_date   DateTime            @db.Date
  status       sales_orders_status @default(draft)
  subtotal     Decimal             @default(0.00) @db.Decimal(18, 2)
  tax_amount   Decimal             @default(0.00) @db.Decimal(18, 2)
  total_amount Decimal             @default(0.00) @db.Decimal(18, 2)
  notes        String?             @db.Text
  created_by   BigInt?             @db.UnsignedBigInt
  deliveries   deliveries[]
  invoices     invoices[]
  sales_items  sales_items[]
  branches     branches?           @relation(fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_so_branch")
  companies    companies           @relation(fields: [company_id], references: [id], onUpdate: Restrict, map: "fk_so_company")
  customers    customers           @relation(fields: [customer_id], references: [id], onUpdate: Restrict, map: "fk_so_customer")
  users        users?              @relation(fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_so_user")

  @@unique([company_id, order_no], map: "uq_so_company_no")
  @@index([branch_id], map: "fk_so_branch")
  @@index([customer_id], map: "fk_so_customer")
  @@index([created_by], map: "fk_so_user")
}

model stock_adjustments {
  id              BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  company_id      BigInt                   @db.UnsignedBigInt
  warehouse_id    BigInt                   @db.UnsignedBigInt
  product_id      BigInt                   @db.UnsignedBigInt
  quantity_delta  Decimal                  @db.Decimal(18, 4)
  reason          String                   @db.VarChar(255)
  adjustment_date DateTime                 @default(now()) @db.DateTime(0)
  status          stock_adjustments_status @default(draft)
  created_by      BigInt?                  @db.UnsignedBigInt
  companies       companies                @relation(fields: [company_id], references: [id], onUpdate: Restrict, map: "fk_adjust_company")
  products        products                 @relation(fields: [product_id], references: [id], onUpdate: Restrict, map: "fk_adjust_product")
  users           users?                   @relation(fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_adjust_user")
  warehouses      warehouses               @relation(fields: [warehouse_id], references: [id], onUpdate: Restrict, map: "fk_adjust_warehouse")

  @@index([company_id], map: "fk_adjust_company")
  @@index([product_id], map: "fk_adjust_product")
  @@index([created_by], map: "fk_adjust_user")
  @@index([warehouse_id], map: "fk_adjust_warehouse")
}

model stock_balances {
  id           BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  company_id   BigInt     @db.UnsignedBigInt
  warehouse_id BigInt     @db.UnsignedBigInt
  product_id   BigInt     @db.UnsignedBigInt
  quantity     Decimal    @default(0.0000) @db.Decimal(18, 4)
  average_cost Decimal    @default(0.00) @db.Decimal(18, 2)
  updated_at   DateTime   @default(now()) @db.DateTime(0)
  companies    companies  @relation(fields: [company_id], references: [id], onUpdate: Restrict, map: "fk_stock_company")
  products     products   @relation(fields: [product_id], references: [id], onUpdate: Restrict, map: "fk_stock_product")
  warehouses   warehouses @relation(fields: [warehouse_id], references: [id], onUpdate: Restrict, map: "fk_stock_warehouse")

  @@unique([company_id, warehouse_id, product_id], map: "uq_stock_company_wh_product")
  @@index([product_id], map: "fk_stock_product")
  @@index([warehouse_id], map: "fk_stock_warehouse")
}

model stock_opnames {
  id                                     BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  company_id                             BigInt               @db.UnsignedBigInt
  warehouse_id                           BigInt               @db.UnsignedBigInt
  opname_date                            DateTime             @db.Date
  status                                 stock_opnames_status @default(draft)
  notes                                  String?              @db.Text
  created_by                             BigInt?              @db.UnsignedBigInt
  approved_by                            BigInt?              @db.UnsignedBigInt
  created_at                             DateTime             @default(now()) @db.DateTime(0)
  users_stock_opnames_approved_byTousers users?               @relation("stock_opnames_approved_byTousers", fields: [approved_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_opname_approver")
  companies                              companies            @relation(fields: [company_id], references: [id], onUpdate: Restrict, map: "fk_opname_company")
  users_stock_opnames_created_byTousers  users?               @relation("stock_opnames_created_byTousers", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_opname_creator")
  warehouses                             warehouses           @relation(fields: [warehouse_id], references: [id], onUpdate: Restrict, map: "fk_opname_warehouse")

  @@index([approved_by], map: "fk_opname_approver")
  @@index([company_id], map: "fk_opname_company")
  @@index([created_by], map: "fk_opname_creator")
  @@index([warehouse_id], map: "fk_opname_warehouse")
}

model suppliers {
  id                 BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  company_id         BigInt            @db.UnsignedBigInt
  code               String            @db.VarChar(40)
  name               String            @db.VarChar(150)
  tax_number         String?           @db.VarChar(100)
  phone              String?           @db.VarChar(50)
  email              String?           @db.VarChar(150)
  address            String?           @db.Text
  payment_terms_days Int               @default(0)
  status             suppliers_status  @default(active)
  created_at         DateTime          @default(now()) @db.DateTime(0)
  updated_at         DateTime          @default(now()) @db.DateTime(0)
  invoices           invoices[]
  payables           payables[]
  purchase_orders    purchase_orders[]
  companies          companies         @relation(fields: [company_id], references: [id], onUpdate: Restrict, map: "fk_suppliers_company")

  @@unique([company_id, code], map: "uq_supplier_company_code")
}

model system_settings {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  company_id    BigInt?  @db.UnsignedBigInt
  setting_key   String   @db.VarChar(100)
  setting_value String   @db.LongText
  setting_group String   @db.VarChar(50)
  description   String?  @db.VarChar(255)
  updated_by    BigInt?  @db.UnsignedBigInt
  updated_at    DateTime @default(now()) @db.DateTime(0)

  @@unique([company_id, setting_key], map: "uq_company_setting")
}

model user_roles {
  user_id    BigInt    @db.UnsignedBigInt
  role_id    BigInt    @db.UnsignedBigInt
  company_id BigInt    @db.UnsignedBigInt
  companies  companies @relation(fields: [company_id], references: [id], onUpdate: Restrict, map: "fk_user_roles_company")
  roles      roles     @relation(fields: [role_id], references: [id], onUpdate: Restrict, map: "fk_user_roles_role")
  users      users     @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_user_roles_user")

  @@id([user_id, role_id, company_id])
  @@index([company_id], map: "fk_user_roles_company")
  @@index([role_id], map: "fk_user_roles_role")
}

model users {
  id                                                BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  username                                          String                      @unique(map: "username") @db.VarChar(80)
  email                                             String                      @unique(map: "email") @db.VarChar(150)
  password_hash                                     String                      @db.VarChar(255)
  name                                              String                      @db.VarChar(150)
  status                                            users_status                @default(active)
  last_login_at                                     DateTime?                   @db.DateTime(0)
  created_at                                        DateTime                    @default(now()) @db.DateTime(0)
  updated_at                                        DateTime                    @default(now()) @db.DateTime(0)
  attachments                                       attachments[]
  audit_logs                                        audit_logs[]
  bank_transactions                                 bank_transactions[]
  cash_transactions                                 cash_transactions[]
  deliveries                                        deliveries[]
  expense_approvals                                 expense_approvals[]
  expenses_expenses_approved_byTousers              expenses[]                  @relation("expenses_approved_byTousers")
  expenses_expenses_requested_byTousers             expenses[]                  @relation("expenses_requested_byTousers")
  goods_receipts                                    goods_receipts[]
  intercompany_transactions                         intercompany_transactions[]
  inventory_transactions                            inventory_transactions[]
  invoices                                          invoices[]
  journal_entries_journal_entries_created_byTousers journal_entries[]           @relation("journal_entries_created_byTousers")
  journal_entries_journal_entries_posted_byTousers  journal_entries[]           @relation("journal_entries_posted_byTousers")
  notifications                                     notifications[]
  payments                                          payments[]
  purchase_orders                                   purchase_orders[]
  purchase_requests                                 purchase_requests[]
  sales_orders                                      sales_orders[]
  stock_adjustments                                 stock_adjustments[]
  stock_opnames_stock_opnames_approved_byTousers    stock_opnames[]             @relation("stock_opnames_approved_byTousers")
  stock_opnames_stock_opnames_created_byTousers     stock_opnames[]             @relation("stock_opnames_created_byTousers")
  user_roles                                        user_roles[]
}

model warehouses {
  id                     BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  company_id             BigInt                   @db.UnsignedBigInt
  branch_id              BigInt?                  @db.UnsignedBigInt
  code                   String                   @db.VarChar(30)
  name                   String                   @db.VarChar(150)
  address                String?                  @db.Text
  status                 warehouses_status        @default(active)
  created_at             DateTime                 @default(now()) @db.DateTime(0)
  updated_at             DateTime                 @default(now()) @db.DateTime(0)
  deliveries             deliveries[]
  goods_receipts         goods_receipts[]
  inventory_transactions inventory_transactions[]
  stock_adjustments      stock_adjustments[]
  stock_balances         stock_balances[]
  stock_opnames          stock_opnames[]
  branches               branches?                @relation(fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_warehouses_branch")
  companies              companies                @relation(fields: [company_id], references: [id], onUpdate: Restrict, map: "fk_warehouses_company")

  @@unique([company_id, code], map: "uq_warehouse_company_code")
  @@index([branch_id], map: "fk_warehouses_branch")
}

