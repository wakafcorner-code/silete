# ==============================================================================
# ERP Manajemen - Environment Configuration (.env.example)
# ==============================================================================

# Database Configuration (MySQL / MariaDB via XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=erp_manajemen
DB_CONNECTION_LIMIT=10

# Application Configuration
NEXT_PUBLIC_APP_NAME="SILETE"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV=development

# Session / JWT Secret (Phase 03)
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-secure-random-secret-key-at-least-32-chars"
AUTH_EXPIRES_IN="8h"
